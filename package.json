{
  "name": "hazardous-materials-cbt",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "python3 -m http.server 4173 --bind 0.0.0.0",
    "test": "node --test tests/*.test.js",
    "validate": "node scripts/validate-bank.js",
    "validate:release": "node scripts/validate-bank.js --release",
    "test:e2e": "npm run build && playwright test",
    "check": "npm run validate:release && npm test && npm run test:e2e",
    "build": "node scripts/build-site.js",
    "coverage": "node scripts/coverage.js"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2"
  }
}
